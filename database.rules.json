{
  "rules": {

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'vendor'",

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'vendor')",

        ".write": "auth != null && auth.uid === $uid",

        ".validate": "newData.hasChildren(['email', 'role'])",

        "email": {
          ".validate": "newData.isString() && newData.val().length > 3 && newData.val().length < 200"
        },

        "role": {
          ".validate": "newData.isString() && (newData.val() === 'buyer' || newData.val() === 'seller' || newData.val() === 'vendor')"
        }
      }
    },


    "sellerNotifications": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'vendor' || root.child('users').child(auth.uid).child('role').val() === 'seller')",

      "$notificationId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'vendor' || (root.child('users').child(auth.uid).child('role').val() === 'seller' && newData.child('sellerId').val() === auth.uid))",

        ".validate": "newData.hasChildren(['sellerId', 'sellerName', 'date', 'session', 'milkAvailable', 'estimatedQuantity', 'updatedAt'])",

        "sellerId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },

        "sellerName": {
          ".validate": "newData.isString()"
        },

        "date": {
          ".validate": "newData.isString()"
        },

        "session": {
          ".validate": "newData.isString() && (newData.val() === 'morning' || newData.val() === 'evening')"
        },

        "milkAvailable": {
          ".validate": "newData.isBoolean() || newData.isNumber()"
        },

        "estimatedQuantity": {
          ".validate": "newData.isNumber()"
        },

        "updatedAt": {
          ".validate": "newData.isString()"
        }
      }
    },


