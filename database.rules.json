        },

        "pendingAmount": {
          ".validate": "newData.isNumber()"
        },

        "paymentStatus": {
          ".validate": "newData.isString() && (newData.val() === 'Paid' || newData.val() === 'Partial' || newData.val() === 'Not Paid')"
        },

        "paymentMethod": {
          ".validate": "newData.isString()"
