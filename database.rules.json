        },

        "createdAt": {
          ".validate": "newData.isString()"
        },

        "updatedAt": {
          ".validate": "newData.isString()"
        }
      }
    },


    "changeRequests": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'vendor' || root.child('users').child(auth.uid).child('role').val() === 'seller' || root.child('users').child(auth.uid).child('role').val() === 'buyer')",

      "$requestId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'vendor' || (root.child('users').child(auth.uid).child('role').val() === 'seller' && data.child('targetUserId').val() === auth.uid) || (root.child('users').child(auth.uid).child('role').val() === 'buyer' && data.child('targetUserId').val() === auth.uid) || (!data.exists() && root.child('users').child(auth.uid).child('role').val() === 'vendor' && newData.child('vendorId').val() === auth.uid))",

        ".validate": "newData.hasChildren(['type', 'transactionType', 'transactionId', 'vendorId', 'targetUserId', 'reason', 'status', 'createdAt'])",

        "type": {
          ".validate": "newData.isString() && (newData.val() === 'edit' || newData.val() === 'delete')"
        },

        "transactionType": {
          ".validate": "newData.isString() && (newData.val() === 'collection' || newData.val() === 'supply')"
        },

        "transactionId": {
          ".validate": "newData.isString()"
        },

        "vendorId": {
          ".validate": "newData.isString()"
        },

        "targetUserId": {
          ".validate": "newData.isString()"
        },

        "reason": {
          ".validate": "newData.isString()"
        },

        "status": {
          ".validate": "newData.isString() && (newData.val() === 'Pending' || newData.val() === 'Approved' || newData.val() === 'Rejected')"
        },

        "createdAt": {
          ".validate": "newData.isString()"
        },

        "oldData": {
          ".validate": "newData.exists()"
        },

        "newData": {
          ".validate": "newData.exists()"
        }
      }
    },


    "passwordResetRequests": {
      ".read": "auth != null && auth.token.email != null && auth.token.email.toLowerCase() === 'akashchinnaswamy2712@gmail.com'",

      "$requestId": {
        ".write": "(!data.exists() && newData.exists() && newData.child('status').val() === 'Pending') || (auth != null && auth.token.email != null && auth.token.email.toLowerCase() === 'akashchinnaswamy2712@gmail.com')",

        ".validate": "newData.hasChildren(['email', 'role', 'reason', 'status', 'createdAt'])",

        "email": {
          ".validate": "newData.isString() && newData.val().length > 3 && newData.val().length < 200"
        },

        "role": {
          ".validate": "newData.isString() && (newData.val() === 'buyer' || newData.val() === 'seller' || newData.val() === 'vendor')"
        },

        "reason": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 1000"
        },

        "status": {
          ".validate": "newData.isString() && (newData.val() === 'Pending' || newData.val() === 'Reviewed')"
        },

        "createdAt": {
          ".validate": "newData.isString()"
        },

        "reviewedAt": {
          ".validate": "newData.isString()"
        },

        "reviewedBy": {
          ".validate": "newData.isString()"
        }
